<?php
/**
 * Registers the Alpine.data for the LS Central gift card amount used totals segment.
 *
 * Mirrors the Luma web/js/view/totals/giftcard-discount.js: reads the applied GIFTCARDNO
 * entries from the ls_pos_data_entries extension attribute so each card renders on its own
 * display line, with a fallback to the aggregate segment value.
 *
 * The AlpineJS scope of this file is the method `initCartTotals()`
 * in Magento_Checkout::php-cart/totals.phtml.
 */

use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
?>
<script>
    function initGiftcardDiscountSegment() {
        return {
            isGiftcardDiscountSegment() {
                return this.segment.code === 'ls_gift_card_amount_used';
            },
            getGiftCardEntries() {
                var extAttrs = this.totalsData && this.totalsData.extension_attributes;
                if (!extAttrs || !extAttrs.ls_pos_data_entries) {
                    return [];
                }
                try {
                    var parsed = JSON.parse(extAttrs.ls_pos_data_entries);
                    if (Array.isArray(parsed)) {
                        return parsed.filter(function (e) {
                            return (e.entry_type || '').toUpperCase() === 'GIFTCARDNO';
                        });
                    }
                } catch (e) {}
                return [];
            },
            entryTitle(entry) {
                var label = entry.entry_type || '<?= $escaper->escapeJs(__('Gift Card')) ?>';
                var code = entry.entry_no || entry.no || '';
                return label + ' - ' + code + ' <?= $escaper->escapeJs(__('Redeemed')) ?>';
            },
            formatEntryAmount(entry) {
                return '-' + hyva.formatPrice(Number(entry.amount) || 0);
            },
            formatGiftcardDiscountValue() {
                return '-' + hyva.formatPrice(this.segment.value);
            }
        };
    }
    window.addEventListener('alpine:init', () => Alpine.data('initGiftcardDiscountSegment', initGiftcardDiscountSegment), {once: true})
</script>
<?php $hyvaCsp->registerInlineScript() ?>
